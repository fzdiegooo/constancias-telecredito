{
  "name": "constancias-telecredito",
  "version": "1.0.0",
  "description": "Descarga automática de constancias de operaciones de TeleCrédito BCP",
  "main": "main.js",
  "scripts": {
    "gui": "node --no-warnings src/server.js",
    "sync": "node --no-warnings src/apicli.js",
    "abrir": "node src/abrir.js",
    "start": "electron .",
    "build:win": "electron-builder --win portable"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "playwright-core": "^1.61.1"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.nativaorganics.constanciastelecredito",
    "productName": "Constancias TeleCredito",
    "asar": false,
    "files": [
      "main.js",
      "src/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Constancias-TeleCredito-portable.exe"
    }
  }
}
